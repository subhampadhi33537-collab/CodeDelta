# ─────────────────────────────────────────────────────────────────────────────
# CodeDelta — .env.example
# Copy this file to .env and fill in REAL values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

ACCESS_TOKEN_MINUTES=15

# ── Database (Supabase Postgres) ──────────────────────────────────────────────
# Pooler connection (port 6543) — used by the app
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

DATABASE_HOST=aws-0-<region>.pooler.supabase.com
DATABASE_PORT=6543
DATABASE_NAME=postgres
DATABASE_USER=postgres.<project-ref>
DATABASE_PASSWORD=

# Direct/session connection (port 5432) — used by LangGraph checkpointer only
# Get from Supabase → Settings → Database → "Session mode" connection string
CHECKPOINT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>.supabase.com:5432/postgres

# ── LangSmith (tracing) ───────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=codedelta

# ── AI providers ──────────────────────────────────────────────────────────────
GROQ_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
TAVILY_API_KEY=

# ── Google Drive ──────────────────────────────────────────────────────────────
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# "oauth" (default) or "service_account"
GOOGLE_AUTH_MODE=oauth

# OAuth mode (run scripts/google_oauth_setup.py once to get these)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Service account mode (path to JSON key file)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Rate limits ───────────────────────────────────────────────────────────────
MAX_RUNS_PER_DAY=50

# ── Frontend (used by Vite) ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
